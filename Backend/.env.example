DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_DB=whatsapp_marketing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=whatsapp-database-service
POSTGRES_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1,whatsapp-backend-service,whatsapp-frontend-service,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:8080
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
ENABLE_PUBLIC_REGISTRATION=False
FRONTEND_URL=http://localhost:8080
DEFAULT_FROM_EMAIL=Wavely <noreply@example.com>
# SMTP server, sender and encrypted credentials are configured in Django Admin.
# Generate once and keep with deployment secrets, outside the database:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SMTP_ENCRYPTION_KEY=
IAM_INVITATION_MAX_AGE_SECONDS=604800
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_USERNAME=platform-admin
NGROK_AUTHTOKEN=
# Keep False when exposing Gunicorn directly over HTTP. Set True only when an
# HTTPS reverse proxy/load balancer supplies X-Forwarded-Proto: https.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
# Optional fallback for a single-number deployment. Per-number IDs can remain in Django Admin.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=new_lead_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_TIMEOUT=10
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=False
# Testing only. Keep False in production; install your network CA instead.
WHATSAPP_DISABLE_TLS_VERIFY=False
CELERY_BROKER_URL=redis://whatsapp-redisdbs-service:6379/0
CELERY_RESULT_BACKEND=redis://whatsapp-redisdbs-service:6379/1
